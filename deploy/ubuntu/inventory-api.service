[Unit]
Description=Henan Inventory API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=inventory_app
Group=inventory_app
WorkingDirectory=/opt/henan-inventory
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=henan_inventory
Environment=PGUSER=inventory_app
Environment=MEDIA_ROOT=/var/lib/henan-inventory/media
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/henan-inventory

[Install]
WantedBy=multi-user.target
