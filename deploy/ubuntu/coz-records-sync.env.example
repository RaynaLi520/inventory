# Copy to /etc/henan-inventory/coz-records-sync.env (mode 0600).
# The two JSON request bodies must be captured from the corresponding Forguncy pages.
COZ_PURCHASE_RECORDS_API_URL=http://it.justinallen.com:8899/coz/Home/GetTableDataWithOffset
COZ_INBOUND_RECORDS_API_URL=http://it.justinallen.com:8899/coz/Home/GetTableDataWithOffset
COZ_PURCHASE_RECORDS_REQUEST_PATH=/etc/henan-inventory/coz-purchase-records-request.json
COZ_INBOUND_RECORDS_REQUEST_PATH=/etc/henan-inventory/coz-inbound-records-request.json
# Set only if the internal endpoint requires a browser session cookie.
# COZ_RECORDS_COOKIE=
