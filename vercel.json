{
  "redirects": [
    {
      "source": "/",
      "destination": "/mobile-install.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/mobile-install.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
